# policy approver configuration — copy to /etc/policy-approver.env, then:
#   sudo chmod 600 /etc/policy-approver.env
# The PAT lives ONLY on the monitoring host. Never on the agent host.

# GitHub webhook secret (same value you register on the repo webhook).
# Server mode only — unused by --check-pr (the Hermes gateway variant in
# ./hermes/ validates HMAC on its own route).
WEBHOOK_SECRET=change-me

# Fine-grained PAT, this repo only, Pull requests RW + Contents RW
GITHUB_TOKEN=github_pat_...

# owner/repo of the iac repository
GITHUB_REPO=<owner>/ops-agent-iac

# Grafana service account token (Viewer) — queried on the same host
GRAFANA_URL=http://localhost:3000
GRAFANA_TOKEN=glsa_...

# LISTEN_PORT=8646
# PROD_NAME_HINT=prod
